     Odoo 19 Community ships no form or list view for account.bank.statement.line
     (the ones that exist come from OCA modules), so this module defines its own
     instead of inheriting. That keeps it installable on a plain Odoo 19. -->
<odoo>

    <record id="view_statement_line_matcher_list" model="ir.ui.view">
        <field name="name">account.bank.statement.line.matcher.list</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <list string="Bank Lines" create="false" multi_edit="0"
                  decoration-success="matcher_state == 'done'"
                  decoration-warning="matcher_state == 'ambiguous'"
                  decoration-muted="matcher_state == 'none'">
                <field name="date"/>
                <field name="journal_id"/>
                <field name="payment_ref"/>
                <field name="partner_id" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_reconciled" optional="hide"/>
                <field name="matcher_state" widget="badge"
                       decoration-success="matcher_state == 'done'"
                       decoration-info="matcher_state == 'suggested'"
                       decoration-warning="matcher_state == 'ambiguous'"/>
                <field name="matcher_candidate_count" string="#"/>
                <button name="action_matcher_refresh" type="object"
                        string="Search again" icon="fa-refresh"/>
            </list>
        </field>
    </record>

    <record id="view_statement_line_matcher_form" model="ir.ui.view">
        <field name="name">account.bank.statement.line.matcher.form</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <form string="Bank Line" create="false">
                <header>
                    <button name="action_matcher_refresh" type="object"
                            string="Search again" class="btn-secondary"
                            icon="fa-refresh"/>
                    <button name="action_matcher_apply_best" type="object"
                            string="Apply best suggestion" class="btn-primary"
                            icon="fa-check"
                            invisible="matcher_state != 'suggested'"/>
                    <button name="action_matcher_unassign" type="object"
                            string="Undo assignment" class="btn-secondary"
                            icon="fa-undo"
                            confirm="This removes the assignment and puts the amount back on the suspense account. Continue?"
                            invisible="not is_reconciled"/>
                    <field name="matcher_state" widget="statusbar"
                           statusbar_visible="todo,suggested,done"/>
                </header>
                <sheet>
                    <group>
                        <group string="Bank Line">
                            <field name="date" readonly="1"/>
                            <field name="journal_id" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="is_reconciled" readonly="1"/>
                        </group>
                        <group string="Reference">
                            <field name="payment_ref" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="ref" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="status"
                         invisible="not matcher_hint">
                        <field name="matcher_hint" readonly="1" nolabel="1"/>
                    </div>
                    <group string="Assign manually"
                           invisible="is_reconciled">
                        <field name="matcher_manual_line_id"
                               options="{'no_create': True, 'no_open': True}"
                               placeholder="Search an open invoice, bill, credit note or payment..."/>
                        <button name="action_matcher_assign_manual" type="object"
                                string="Assign this document" class="btn-primary"
                                invisible="not matcher_manual_line_id"/>
                    </group>
                    <separator string="Suggestions"/>
                    <field name="matcher_candidate_ids" readonly="1" nolabel="1">
                        <list create="false" delete="false">
                            <field name="score" string="Confidence"/>
                            <field name="rule" string="Matched by"/>
                            <field name="move_id"/>
                            <field name="partner_id"/>
                            <field name="date"/>
                            <field name="amount_residual"/>
                            <field name="currency_id" column_invisible="1"/>
                            <button name="action_apply" type="object"
                                    string="Assign" class="btn-primary"
                                    icon="fa-check"/>
                            <button name="action_open_document" type="object"
                                    string="Open" icon="fa-external-link"/>
                        </list>
                    </field>
                    <div class="text-muted mt8">
                        A line that finds nothing today can be searched again later:
                        vendor bills, credit notes and down payments entered
                        afterwards are picked up by "Search again".
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_statement_line_matcher_search" model="ir.ui.view">
        <field name="name">account.bank.statement.line.matcher.search</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <search string="Bank Lines">
                <field name="payment_ref"/>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <filter name="unassigned" string="Unassigned"
                        domain="[('is_reconciled', '=', False)]"/>
                <filter name="has_suggestion" string="Has suggestion"
                        domain="[('matcher_state', '=', 'suggested')]"/>
                <filter name="ambiguous" string="Ambiguous"
                        domain="[('matcher_state', '=', 'ambiguous')]"/>
                <filter name="no_match" string="No match"
                        domain="[('matcher_state', '=', 'none')]"/>
                <group name="groupby">
                    <filter name="group_journal" string="Journal"
                            context="{'group_by': 'journal_id'}"/>
                    <filter name="group_state" string="Matching"
                            context="{'group_by': 'matcher_state'}"/>
                    <filter name="group_partner" string="Partner"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_statement_line_matcher" model="ir.actions.act_window">
        <field name="name">Bank Line Assignment</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_statement_line_matcher_search"/>
        <field name="context">{'search_default_unassigned': 1, 'search_default_group_journal': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing left to assign.</p>
            <p>Imported bank lines that are not yet assigned to a document appear here.</p>
        </field>
    </record>

    <!-- Bind our own views to the action so OCA views do not take precedence. -->
    <record id="action_statement_line_matcher_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_statement_line_matcher_list"/>
        <field name="act_window_id" ref="action_statement_line_matcher"/>
    </record>
    <record id="action_statement_line_matcher_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_statement_line_matcher_form"/>
        <field name="act_window_id" ref="action_statement_line_matcher"/>
    </record>


    <!-- Open the assignment screen for selected statements. Works from the
         statement list that core Odoo provides, without needing a form view. -->
    <record id="action_statement_open_assignment" model="ir.actions.act_window">
        <field name="name">Assign Bank Lines</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_statement_line_matcher_search"/>
        <field name="domain">[('statement_id', 'in', active_ids)]</field>
        <field name="binding_model_id" ref="account.model_account_bank_statement"/>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
