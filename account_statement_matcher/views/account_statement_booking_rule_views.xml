<odoo>

    <record id="view_booking_rule_list" model="ir.ui.view">
        <field name="name">account.statement.booking.rule.list</field>
        <field name="model">account.statement.booking.rule</field>
        <field name="arch" type="xml">
            <list string="Booking Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="direction"/>
                <field name="keywords"/>
                <field name="partner_id" optional="show"/>
                <field name="account_id"/>
                <field name="assign_partner_id" optional="hide"/>
                <field name="auto_apply" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_booking_rule_form" model="ir.ui.view">
        <field name="name">account.statement.booking.rule.form</field>
        <field name="model">account.statement.booking.rule</field>
        <field name="arch" type="xml">
            <form string="Booking Rule">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <group>
                        <group string="When">
                            <field name="direction"/>
                            <field name="keywords" placeholder="One word per line, for example: rent"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Then">
                            <field name="account_id" options="{'no_create': True}"/>
                            <field name="assign_partner_id"/>
                            <field name="auto_apply"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        The rules are tried in order and the first that fits wins. They
                        only apply to lines for which the search found no document
                        with a matching reference, or with partner and amount together.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_booking_rule" model="ir.actions.act_window">
        <field name="name">Booking Rules</field>
        <field name="res_model">account.statement.booking.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a booking rule</p>
            <p>Rent, bank fees, interest and salaries are paid without an invoice.
            A rule books such bank lines on the right account.</p>
        </field>
    </record>

</odoo>
