<odoo noupdate="1">
    <!-- Background search of all open bank lines. Also started shortly after invoices or bills are posted;
         once a day as a safety net. -->
    <record id="ir_cron_refresh_open" model="ir.cron">
        <field name="name">Bank Line Assignment: search open lines again</field>
        <field name="model_id" ref="account.model_account_bank_statement_line"/>
        <field name="state">code</field>
        <field name="code">model._matcher_refresh_open()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
