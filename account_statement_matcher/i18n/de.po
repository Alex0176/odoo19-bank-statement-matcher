#. odoo-python
#: code:addons/account_statement_matcher/wizard/statement_match_wizard.py:0
msgid "%(applied)s assigned, %(skipped)s left for review, %(failed)s failed."
msgstr ""
"%(applied)s zugeordnet, %(skipped)s zur Prüfung, %(failed)s fehlgeschlagen."

#. module: account_statement_matcher
#. odoo-python
#: code:addons/account_statement_matcher/models/account_bank_statement_line.py:0
msgid ""
"%(label)s %(name)s (%(partner)s, %(amount)s) matches this payment but has no"
" open item yet -- it is probably not invoiced."
msgstr ""
"%(label)s %(name)s (%(partner)s, %(amount)s) passt zu dieser Zahlung, hat "
"aber noch keinen offenen Posten – vermutlich noch nicht fakturiert."

#. module: account_statement_matcher
#. odoo-python
#: code:addons/account_statement_matcher/models/account_bank_statement_line.py:0
msgid ""
"%s has no date and cannot be reconciled. Such rows usually come from a "
"migration; the date has to be corrected on the document first."
msgstr ""
"%s hat kein Datum und kann nicht ausgeglichen werden. Solche Zeilen stammen "
"meist aus einer Migration; das Datum muss zuerst am Beleg berichtigt werden."

#. module: account_statement_matcher
#. odoo-python
#: code:addons/account_statement_matcher/models/account_bank_statement_line.py:0
