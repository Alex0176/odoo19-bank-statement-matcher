<odoo>
    <record id="view_statement_match_wizard_form" model="ir.ui.view">
        <field name="name">account.statement.match.wizard.form</field>
        <field name="model">account.statement.match.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Bank Lines">
                <div class="alert alert-info" role="status"
                     invisible="not message">
                    <field name="message" readonly="1" nolabel="1"/>
                </div>
                <group>
                    <field name="only_unassigned"/>
                </group>
                <field name="line_ids" readonly="1">
                    <list create="false" delete="false">
                        <field name="date"/>
                        <field name="payment_ref"/>
                        <field name="amount" sum="Total"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="matcher_state" widget="badge"/>
                        <field name="matcher_candidate_count" string="#"/>
                    </list>
                </field>
                <footer>
                    <button name="action_refresh" type="object" string="Search again"
                            class="btn-secondary"/>
                    <button name="action_apply" type="object"
                            string="Assign unambiguous matches" class="btn-primary"
                            confirm="This posts the assignments for every line with exactly one best suggestion. Continue?"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_statement_match_wizard" model="ir.actions.act_window">
        <field name="name">Assign Bank Lines</field>
        <field name="res_model">account.statement.match.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_bank_statement_line"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
